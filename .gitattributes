# Normalize all text to LF in the repo and on checkout (works the same on macOS, Linux and Windows)
* text=auto eol=lf

# Source and project files
*.cs        text diff=csharp
*.csproj    text
*.props     text
*.targets   text
*.slnx      text
*.json      text
*.xml       text
*.yml       text
*.yaml      text
*.md        text diff=markdown

# Visual Studio classic solutions expect CRLF
*.sln       text eol=crlf

# Shell scripts must stay LF; Windows scripts must stay CRLF
*.sh        text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binaries
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.dll       binary
*.exe       binary
